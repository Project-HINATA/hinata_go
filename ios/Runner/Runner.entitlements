<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.developer.associated-appclip-app-identifiers</key>
	<array>
		<string>$(AppIdentifierPrefix)moe.neri.hinatago.prism</string>
	</array>
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>appclips:link.neri.moe</string>
		<string>appclips:link-beta.neri.moe</string>
		<string>applinks:link.neri.moe</string>
		<string>applinks:link-beta.neri.moe</string>
		<string>webcredentials:link.neri.moe</string>
		<string>webcredentials:link-beta.neri.moe</string>
	</array>
	<key>com.apple.developer.nfc.readersession.formats</key>
	<array>
		<string>TAG</string>
	</array>
	<!-- Required for remote Live Activity updates. Without this the app cannot obtain an
	     APNs push token, so a visit billed from another channel could never reach the
	     Dynamic Island while the app is suspended. TestFlight and App Store builds are
	     signed against the production APNs environment regardless of this value. -->
	<key>aps-environment</key>
	<string>production</string>
</dict>
</plist>
