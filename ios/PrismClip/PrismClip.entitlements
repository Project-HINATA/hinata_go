<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>appclips:link.neri.moe</string>
		<string>appclips:link-beta.neri.moe</string>
		<string>webcredentials:link.neri.moe</string>
		<string>webcredentials:link-beta.neri.moe</string>
	</array>
	<key>com.apple.developer.parent-application-identifiers</key>
	<array>
		<string>$(AppIdentifierPrefix)moe.neri.hinatago</string>
	</array>
	<!-- The App Clip starts its own Live Activity, so it needs its own push token to let a
	     session opened on another channel update it. TestFlight builds sign against the
	     production APNs environment regardless of this value. -->
	<key>aps-environment</key>
	<string>production</string>
</dict>
</plist>
