default_platform(:ios)

# App Store Connect rejects a submission whose version has no What's New in
# any of its localizations, or, because the app ships an App Clip, no default
# App Clip experience. Fill in both before deliver submits the version.
def prepare_app_store_version
  bundle_id = ENV.fetch("IOS_BUNDLE_ID")
  app_version = ENV.fetch("IOS_APP_VERSION")
  platform = Spaceship::ConnectAPI::Platform::IOS

  app = Spaceship::ConnectAPI::App.find(bundle_id)
  UI.user_error!("App #{bundle_id} not found in App Store Connect") if app.nil?

  # ensure_version! renames whatever version is editable, and a version
  # waiting for review counts as editable: it would turn the release under
  # review into this one.
  pending = app.get_edit_app_store_version(platform: platform)
  if pending &&
     pending.version_string != app_version &&
     pending.app_version_state == Spaceship::ConnectAPI::AppStoreVersion::AppVersionState::WAITING_FOR_REVIEW
    UI.user_error!("Version #{pending.version_string} is still waiting for review; let it finish or withdraw it before submitting #{app_version}")
  end

  # deliver does the same before uploading; doing it first gives us the
  # version to fill in.
  app.ensure_version!(app_version, platform: platform)
  version = app.get_edit_app_store_version(platform: platform)
  UI.user_error!("No editable App Store version #{app_version}") if version.nil?

  set_whats_new(version)
  ensure_app_clip_default_experience(app, version, platform)
end

def set_whats_new(version)
  notes_dir = ENV.fetch("IOS_RELEASE_NOTES_DIR")
  notes = {
    zh: File.read(File.join(notes_dir, "zh.txt")).strip,
    en: File.read(File.join(notes_dir, "en.txt")).strip
  }

  version.get_app_store_version_localizations.each do |localization|
    text = localization.locale.start_with?("zh") ? notes[:zh] : notes[:en]
    localization.update(attributes: { whats_new: text })
    UI.message("Set What's New for #{localization.locale}")
  end
end

# The App Clip the build embeds. App Store Connect still lists the clip the
# app shipped before the rename (moe.neri.hinatago.ArcadeLink); a default
# experience tied to that clip makes review submission fail with "The app clip
# in the build does not match the app clip that is related to the app clip
# version".
APP_CLIP_BUNDLE_ID = "moe.neri.hinatago.prism"

def app_clip_of_experience(experience_id)
  Spaceship::ConnectAPI.get_app_clip_default_experience(
    app_clip_default_experience_id: experience_id,
    includes: "appClip"
  ).body.dig("data", "relationships", "appClip", "data", "id")
end

def ensure_app_clip_default_experience(app, version, platform)
  tunes = Spaceship::ConnectAPI.client.tunes_request_client
  app_clips = Spaceship::ConnectAPI.get_app_clips(app_id: app.id).body["data"]
  return UI.message("App has no App Clip") if app_clips.empty?

  app_clip = app_clips.find { |clip| clip.dig("attributes", "bundleId") == APP_CLIP_BUNDLE_ID }
  if app_clip.nil?
    listed = app_clips.map { |clip| clip.dig("attributes", "bundleId") }.join(", ")
    UI.user_error!("App Clip #{APP_CLIP_BUNDLE_ID} not found in App Store Connect (found: #{listed})")
  end

  current = tunes.get("v1/appStoreVersions/#{version.id}/appClipDefaultExperience").body["data"]
  if current
    current_clip = app_clip_of_experience(current["id"])
    return UI.message("App Clip default experience already set") if current_clip == app_clip["id"]

    # An experience of another clip cannot be pointed elsewhere; replace it.
    UI.important("Default experience #{current["id"]} belongs to another App Clip; replacing it")
    tunes.delete("v1/appClipDefaultExperiences/#{current["id"]}")
  end

  # Copy the experience of the live version, or else any earlier one, as long
  # as it belongs to the same clip.
  template = nil
  live_version = app.get_live_app_store_version(platform: platform)
  if live_version
    live = tunes.get("v1/appStoreVersions/#{live_version.id}/appClipDefaultExperience").body["data"]
    template = live if live && app_clip_of_experience(live["id"]) == app_clip["id"]
  end
  template ||= tunes.get("v1/appClips/#{app_clip["id"]}/appClipDefaultExperiences").body["data"].first
  if template.nil?
    UI.important("No earlier App Clip default experience to copy; set one up in App Store Connect")
    return
  end

  Spaceship::ConnectAPI.post_app_clip_default_experience(
    app_clip_id: app_clip["id"],
    app_store_version_id: version.id,
    attributes: nil,
    template_default_experience_id: template["id"]
  )
  UI.success("Copied App Clip default experience #{template["id"]} to version #{version.version_string}")
end

platform :ios do
  desc "Refresh App Store profiles using the installed distribution identity"
  lane :prepare_distribution_profiles do
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("IOS_ASC_KEY_ID"),
      issuer_id: ENV.fetch("IOS_ASC_ISSUER_ID"),
      key_content: ENV.fetch("IOS_ASC_KEY_P8_BASE64"),
      is_key_content_base64: true,
      in_house: false
    )

    [
      "moe.neri.hinatago",
      "moe.neri.hinatago.prism",
      "moe.neri.hinatago.liveactivity",
      "moe.neri.hinatago.prism.liveactivity"
    ].each do |bundle_id|
      get_provisioning_profile(
        api_key: api_key,
        app_identifier: bundle_id,
        provisioning_name: "HINATA CI App Store #{bundle_id}",
        ignore_profiles_with_different_name: true,
        output_path: ENV.fetch("RUNNER_TEMP"),
        filename: "#{bundle_id}.mobileprovision",
        force: true,
        # Profiles come straight from the authenticated App Store Connect API;
        # local WWDR verification is redundant and breaks when the runner
        # cannot install the WWDR intermediate ("Could not install WWDR
        # certificate").
        skip_certificate_verification: true
      )
    end
  end

  desc "Calculate the next App Store build number"
  lane :next_build_number do
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("IOS_ASC_KEY_ID"),
      issuer_id: ENV.fetch("IOS_ASC_ISSUER_ID"),
      key_content: ENV.fetch("IOS_ASC_KEY_P8_BASE64"),
      is_key_content_base64: true,
      in_house: false
    )

    live_build = begin
      app_store_build_number(
        api_key: api_key,
        app_identifier: ENV.fetch("IOS_BUNDLE_ID"),
        live: true,
        initial_build_number: 0
      ).to_i
    rescue StandardError
      0
    end

    testflight_build = begin
      latest_testflight_build_number(
        api_key: api_key,
        app_identifier: ENV.fetch("IOS_BUNDLE_ID"),
        initial_build_number: live_build
      ).to_i
    rescue StandardError
      live_build
    end

    github_build = ENV.fetch("GITHUB_RUN_NUMBER", "0").to_i
    puts "NEXT_BUILD_NUMBER=#{[live_build, testflight_build, github_build].max + 1}"
  end

  desc "Upload the already-built IPA to TestFlight or App Store Connect"
  lane :publish do
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("IOS_ASC_KEY_ID"),
      issuer_id: ENV.fetch("IOS_ASC_ISSUER_ID"),
      key_content: ENV.fetch("IOS_ASC_KEY_P8_BASE64"),
      is_key_content_base64: true,
      in_house: false
    )

    ipa_path = ENV.fetch("IOS_IPA_PATH")
    channel = ENV.fetch("IOS_RELEASE_CHANNEL")

    if channel == "beta"
      upload_to_testflight(
        api_key: api_key,
        ipa: ipa_path,
        skip_waiting_for_build_processing: true,
        distribute_external: false
      )
    elsif channel == "production"
      prepare_app_store_version
      upload_to_app_store(
        api_key: api_key,
        ipa: ipa_path,
        submit_for_review: true,
        automatic_release: true,
        skip_screenshots: true,
        skip_metadata: true,
        precheck_include_in_app_purchases: false,
        force: true
      )
    else
      UI.user_error!("Unsupported IOS_RELEASE_CHANNEL: #{channel}")
    end
  end
end
